{
  "name": "tracekit-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, synthetic bug reports for an instrumented checkout demo.",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite --host 127.0.0.1 --port 5183",
    "build": "tsc --noEmit && vite build && node scripts/manifest.mjs",
    "build:core": "tsc -p packages/tracekit/tsconfig.json",
    "preview": "vite preview --host 127.0.0.1 --port 4183",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build:core && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
